<% layout('/flash/adminNav') %>

<div class="admin-main">
  <nav class="site-nav">
    <button class="sidebar-toggle">
      <span class="material-symbols-rounded">menu</span>
    </button>
  </nav>
  <div class="container">
    <!-- Sidebar -->
    <aside class="sidebar collapsed">
      <!-- Sidebar header -->
      <div class="sidebar-header">
        <img src="/photos/rep short logo.png" alt="CodingNepal" class="header-logo" />
        <button class="sidebar-toggle">
          <span class="material-symbols-rounded">chevron_left</span>
        </button>
      </div>
      <div class="sidebar-content">

        <!-- Sidebar Menu -->
        <ul class="menu-list">
          <li class="menu-item">
            <a href="/repulsor/<%=admin._id%>" class="menu-link ">
              <span class="material-symbols-rounded">dashboard</span>
              <span class="menu-label">Dashboard</span>
            </a>
          </li>
          <li class="menu-item">
            <a href="/repulsor/<%=admin._id%>/student" class="menu-link ">
              <span class="material-symbols-rounded"><i class="fa-solid fa-user-graduate"></i></span>
              <span class="menu-label">Students</span>
            </a>
          </li>
          <li class="menu-item ">
            <a href="/repulsor/<%=admin._id%>/staff" class="menu-link active">
              <span class="material-symbols-rounded"><i class="fa-solid fa-person-chalkboard"></i></span>
              <span class="menu-label">Teachers</span>
            </a>
          </li>
          <li class="menu-item">
            <a href="" class="menu-link">
              <span class="material-symbols-rounded"><i class="fa-regular fa-calendar-days"></i></span>
              <span class="menu-label">Class Schedule</span>
            </a>
          </li>
          <li class="menu-item">
            <a href="#" class="menu-link">
              <span class="material-symbols-rounded"><i class="fa-solid fa-building-columns"></i></span>
              <span class="menu-label">Finance</span>
            </a>
          </li>
          <li class="menu-item">
            <a href="#" class="menu-link">
              <span class="material-symbols-rounded"><i class="fa-solid fa-book-open"></i></span>
              <span class="menu-label">Library</span>
            </a>
          </li>
          <li class="menu-item">
            <a href="#" class="menu-link">
              <span class="material-symbols-rounded"><i class="fa-regular fa-user"></i></span>
              <span class="menu-label">Profile</span>
            </a>
          </li>
        </ul>
      </div>
      <!-- Sidebar Footer -->
      <div class="sidebar-footer">
        <button class="theme-toggle">
          <div class="theme-label">
            <span class="theme-icon material-symbols-rounded">dark_mode</span>
            <span class="theme-text">Dark Mode</span>
          </div>
          <div class="theme-toggle-track">
            <div class="theme-toggle-indicator"></div>
          </div>
        </button>
      </div>
    </aside>

    <div class="main-content">

      <div class="page-title">
        <div class="title">
          <h1><%= admin.Title %></h1>
          <h6><%= admin.City %> , <%= admin.State %></h6>
        </div>
        <a href="/repulsor/logout">Logout</a>
      </div>
      <div class="filter">
        <a href=" /repulsor/<%=admin._id%>/addMember ">+ Add Member</a>
      </div>


      <div class="teacherTable" style="display: flex; justify-content: center; flex-direction: column;">
        <h1>Management</h1>
        <table class="rwd-table">
          <tr class="tableHead">
            <th>Sr No.</th>
            <th>Teacher ID</th>
            <th>Name</th>
            <th>Position</th>

            <th>Email</th>
            <th>Contact</th>
            <th>Photo</th>
          </tr>

          <% let i = 0 %>
          <% if (teacher && teacher.length > 0) { %>
          <% teacher.forEach((teacher, i) => { %>
          <% if(teacher.type == "Management") { %>

          <tr class="tableItem">
            <td><%= i + 1 %></td>
            <td><%= teacher.teacherId %></td>
            <td><%= teacher.name %></td>
            <td><%= teacher.position %></td>

            <td><%=teacher.email %></td>
            <td><%=teacher.contact %></td>
            <td>
              <% if (!teacher.photo || !teacher.photo.url) { %>
              <img src="/photos/profile.png" alt="" width="50px">
              <% } else { %>
              <img src="<%= teacher.photo.url %>" alt="" width="50px" style="border-radius: 50%; ">
              <% } %>
            </td>


          </tr>
          <% }   %>



          <% }) %>
          <% } else { %>
          <tr>
            <td colspan="5" class="text-center">No teachers found</td>
          </tr>
          <% } %>

        </table>
      </div>

      <div class="teacherTable" style="display: flex; justify-content: center; flex-direction: column;">
        <h1>Faculties</h1>
        <table class="rwd-table">
          <tr class="tableHead">
            <th>Sr No.</th>
            <th>Teacher ID</th>
            <th>Name</th>
            <th>Position</th>

            <th>Email</th>
            <th>Contact</th>
            <th>Photo</th>
          </tr>
          <% let j = 0 %>
          <% if (teacher && teacher.length > 0) { %>
          <% let i = 0 %>
          <% teacher.forEach((teacher, j) => { %>
          <% if(teacher.type == "Faculty") { %>
          <tr class="tableItem">
            <td><%= j + 1 %></td>
            <td><%= teacher.teacherId %></td>
            <td><%= teacher.name %></td>
            <td><%= teacher.position %></td>

            <td><%=teacher.email %></td>
            <td><%=teacher.contact %></td>
            <td>
              <% if (!teacher.photo || !teacher.photo.url) { %>
              <img src="/photos/profile.png" alt="" width="50px">
              <% } else { %>
              <img src="<%= teacher.photo.url %>" alt="" width="50px" style="border-radius: 50%; ">
              <% } %>
            </td>


          </tr>
          <% }   %>

          <% }) %>
          <% } else { %>
          <tr>
            <td colspan="5" class="text-center">No teachers found</td>
          </tr>
          <% } %>

        </table>
      </div>

      <div class="teacherTable" style="display: flex; justify-content: center; flex-direction: column;">
        <h1>Support Staff</h1>
        <table class="rwd-table">
          <tr class="tableHead">
            <th>Sr No.</th>
            <th>Teacher ID</th>
            <th>Name</th>
            <th>Position</th>

            <th>Email</th>
            <th>Contact</th>
            <th>Photo</th>
          </tr>
          <% if (teacher && teacher.length > 0) { %>
          <% let k = 0 %>

          <% teacher.forEach((teacher, k) => { %>
          <% if(teacher.type == "supportStaff") { %>
          <tr class="tableItem">
            <td><%= k + 1 %></td>
            <td><%= teacher.teacherId %></td>
            <td><%= teacher.name %></td>
            <td><%= teacher.position %></td>

            <td><%=teacher.email %></td>
            <td><%=teacher.contact %></td>
            <td>
              <% if (!teacher.photo || !teacher.photo.url) { %>
              <img src="/photos/profile.png" alt="" width="50px">
              <% } else { %>
              <img src="<%= teacher.photo.url %>" alt="" width="50px" style="border-radius: 50%; ">
              <% } %>
            </td>


          </tr>
          <% }   %>

          <% }) %>
          <% } else { %>
          <tr>
            <td colspan="5" class="text-center">No teachers found</td>
          </tr>
          <% } %>


        </table>
      </div>




    </div>

  </div>
</div>

