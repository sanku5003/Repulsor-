<% layout('/flash/flash') %>
<div class="add-nav">
  <div class="logo">
    <img src="/photos/Gemini_Generated_Image_bqkgnzbqkgnzbqkg-Picsart-BackgroundRemover.png" alt="" width="180px" height="70px">
  </div>
  <div class="profile">
    <div class="profile-icon">
      <i class="fa-regular fa-circle-user"></i>
    </div>
    <div class="admin-detail">
      <h5><%= admin.adminName %> </h5>
      <h6>admin</h6>
    </div>
  </div>
</div>

<main class="signup">
  <h1>Add New Staff Member</h1>
  <img src="/photos/Gemini_Generated_Image_4ypngu4ypngu4ypn-removebg-preview.png" alt="" width="500px" style="margin-bottom: 40px; margin: 0 auto;">
  <div class="inner">
    <form method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
      <div class="inline">
        <div class="col-md-6">
          <label for="name" class="form-label"> Name : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="name" placeholder="Enter Name" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-2">
          <label for="inputState" class="form-label">Type :</label>
          <select id="inputState" class="form-select" name="type" required>
            <option selected disabled>Member Type</option>
            <option value="Management">Management</option>
            <option value="Faculty">Faculty</option>
            <option value="supportStaff">Support Staff</option>


          </select>
        </div>
        <div class="col-md-2">
          <label for="inputState" class="form-label">Gender :</label>
          <select id="inputState" class="form-select" name="gender" required>
            <option selected disabled>Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Others..</option>
          </select>
        </div>
      </div>
      <div class="inline">
        <div class="col-md-4">
          <label for="inputCity" class="form-label">Registration No : </label>
          <input type="text" value="<%= oldData?.teacherId || '' %>" class="form-control <%= errors?.teacherId ? 'is-invalid' : '' %>" id="inputCity" placeholder="Enter Registration No. " name='teacherId' maxlength="10" required>
          <% if (errors?.teacherId) { %>
          <div class="invalid-feedback">
            <%= errors.teacherId %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            please enter Registration No.
          </div>
        </div>
        <div class="col-md-3">
          <label for="name" class="form-label">Joining Date : </label>
          <input type="date" class="form-control" id="exampleFormControlInput1" name="joiningDate" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>

      </div>
      <div class="inline">
        <div class="col-md-4">
          <label for="image" class="form-label"> Photo :</label>
          <input name="photo" type="file" accept=".png, .webp, .jpg" class="form-control" required />
          <div class="invalid-feedback">Image URL is required. Accepted Formats Are .png/.jpg/.webp</div>
        </div>
        <div class="col-md-4">
          <label for="inputCity" class="form-label">Contact : </label>
          <input type="text" id="inputCity" value="<%= oldData?.contact || '' %>" class="form-control <%= errors?.contact ? 'is-invalid' : '' %>" placeholder="Enter Institute Contact No. " name="contact" pattern="[0-9]{10}" required>
          <% if (errors?.contact) { %>
          <div class="invalid-feedback">
            <%= errors.contact %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            please enter a valid contact no
          </div>
        </div>
        <div class="col-md-6">
          <label for="inputCity" class="form-label">Email : </label>
          <input type="email" id="inputCity" placeholder="Enter Institute Email" name="email" value="<%= oldData?.email || '' %>" class="form-control <%= errors?.email ? 'is-invalid' : '' %>" required>
          <% if (errors?.email) { %>
          <div class="invalid-feedback">
            <%= errors.email %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            Please Enter a valid Email
          </div>
        </div>

      </div>
      <div class="mb-3">

        <label for="name" class="form-label">Enter Address : </label>
        <input type="text" class="form-control" id="exampleFormControlInput1" name="Address" placeholder="Eg : 450 , near Airtel tower , Master Colony " required>
        <div class="invalid-feedback">
          this field can't be empty
        </div>

      </div>

      <div class="inline">
        <div class="col-md-3">
          <label for="inputZip" class="form-label">City : </label>
          <input type="text" class="form-control" id="inputZip" name="City" placeholder="Enter City" required>
          <div class="invalid-feedback">
            Please enter your Institute City.
          </div>
        </div>
        <div class="col-md-4">
          <label for="inputState" class="form-label">State</label>
          <select id="inputState" class="form-select" name="State" required>
            <option value="" selected disabled>Select State</option>
            <option value="Andhra Pradesh">Andhra Pradesh</option>
            <option value="Arunachal Pradesh">Arunachal Pradesh</option>
            <option value="Assam">Assam</option>
            <option value="Bihar">Bihar</option>
            <option value="Chhattisgarh">Chhattisgarh</option>
            <option value="Goa">Goa</option>
            <option value="Gujarat">Gujarat</option>
            <option value="Haryana">Haryana</option>
            <option value="Himachal Pradesh">Himachal Pradesh</option>
            <option value="Jharkhand">Jharkhand</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Kerala">Kerala</option>
            <option value="Madhya Pradesh">Madhya Pradesh</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Manipur">Manipur</option>
            <option value="Meghalaya">Meghalaya</option>
            <option value="Mizoram">Mizoram</option>
            <option value="Nagaland">Nagaland</option>
            <option value="Odisha">Odisha</option>
            <option value="Punjab">Punjab</option>
            <option value="Rajasthan">Rajasthan</option>
            <option value="Sikkim">Sikkim</option>
            <option value="Tamil Nadu">Tamil Nadu</option>
            <option value="Telangana">Telangana</option>
            <option value="Tripura">Tripura</option>
            <option value="Uttar Pradesh">Uttar Pradesh</option>
            <option value="Uttarakhand">Uttarakhand</option>
            <option value="West Bengal">West Bengal</option>

            <option value="Andaman and Nicobar Islands">Andaman and Nicobar Islands</option>
            <option value="Chandigarh">Chandigarh</option>
            <option value="Dadra and Nagar Haveli and Daman and Diu">Dadra and Nagar Haveli and Daman and Diu</option>
            <option value="Delhi">Delhi</option>
            <option value="Jammu and Kashmir">Jammu and Kashmir</option>
            <option value="Ladakh">Ladakh</option>
            <option value="Lakshadweep">Lakshadweep</option>
            <option value="Puducherry">Puducherry</option>
            <div class="invalid-feedback">
              Enter Your State
            </div>
          </select>
        </div>
        <div class="col-md-3">
          <label for="inputCity" class="form-label">Pincode : </label>
          <input type="text" class="form-control" id="inputCity" placeholder="6 digit Pin Code" name="pinCode" pattern="[0-9]{6}" required>
          <div class="invalid-feedback">
            Please enter valid Pin Code.
          </div>
        </div>
      </div>
      <div class="inline">
        <div class="col-md-6">
          <label for="position" class="form-label"> Position : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="position" placeholder="Eg : Assistant Teacher, lecturer etc" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-6">
          <label for="position" class="form-label">Any Specific Role(optional) : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="role" placeholder="Eg : Co-ordinator etc">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-6">
          <label for="position" class="form-label">Subject : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="subject" placeholder="Eg : Physics , Chemistry etc">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
      </div>
      <br>
      <label for="heading">Financial Details : </label>
      <br>
      <div class="inline">
        <div class="col-md-3">

          <label for="position" class="form-label">Enter Salary Account No : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="account" placeholder="Enter Account No.">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>

        <div class="col-md-6">
          <label for="position" class="form-label">Enter IFSC Code : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="IFSC" placeholder="IFSC Code">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
      </div>
      <label for="">Salary :</label>
      <br>
      <div class="inline">
        <div class="col-md-2">
          <label for="position" class="form-label"> In Hand Salary : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="salary.inhand" placeholder="In Hand Salary">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-2">
          <label for="position" class="form-label"> Employee Provident Fund : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="salary.epf" placeholder="Epf...">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-2">
          <label for="position" class="form-label"> Others : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="salary.others" placeholder="Other Charges Deducted">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-2">
          <label for="position" class="form-label"> Total : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="salary.total" placeholder="Total Salary">
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
      </div>
      <div class="signup-btn">
        <button type="submit" class="btn btn-primary">Add Member</button>
      </div>
    </form>
  </div>
</main>