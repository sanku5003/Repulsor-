<% layout('/flash/flash') %>
<div class="sign-navbar">
  <div class="logo">
    <img src="/photos/Gemini_Generated_Image_bqkgnzbqkgnzbqkg-Picsart-BackgroundRemover.png" alt="" width="180px" height="70px">
  </div>
  <button type="button" class="btn btn-outline-light">Back To Home</button>
</div>


<main class="signup">
  <h1>Add New Student</h1>
  <img src="/photos/Gemini_Generated_Image_4ypngu4ypngu4ypn-removebg-preview.png" alt="" width="500px" style="margin-bottom: 40px; margin: 0 auto;">
  <div class="inner">
    <form method="POST" class="needs-validation" novalidate enctype="multipart/form-data">
      <div class="inline">
        <div class="col-md-6">
          <label for="name" class="form-label">Student's Name : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="name" placeholder="Enter Students Name" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-2">
          <label for="inputState" class="form-label">Class :</label>
          <select id="inputState" class="form-select" name="class" required>
            <option selected disabled>Select Class</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="10">10</option>
            <option value="11">11</option>
            <option value="12">12</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="inputState" class="form-label">Section :</label>
          <select id="inputState" class="form-select" name="sec" required>
            <option selected disabled>Select Section</option>
            <option value="A">A</option>
            <option value="B">B</option>


          </select>
        </div>
      </div>

      <div class="inline">
        <div class="col-md-4">
          <label for="image" class="form-label">Student Photo :</label>
          <input name="photo" type="file" accept=".png, .webp, .jpg" class="form-control" required />
          <div class="invalid-feedback">Image URL is required. Accepted Formats Are .png/.jpg/.webp</div>
        </div>

        <div class="col-md-2">
          <label for="inputState" class="form-label">Gender :</label>
          <select id="inputState" class="form-select" name="gender" required>
            <option selected disabled>Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Others..</option>
          </select>
        </div>

        <div class="col-md-3">
          <label for="name" class="form-label">Date Of Birth : </label>
          <input type="date" class="form-control" id="exampleFormControlInput1" name="dob" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>




      </div>

      <div class="inline">
        <div class="col-md-4">
          <label for="inputCity" class="form-label">Contact : </label>
          <input type="text" id="inputCity" value="<%= oldData?.contact || '' %>" class="form-control <%= errors?.contact ? 'is-invalid' : '' %>" placeholder="Enter Institute Contact No. " name="contact" pattern="[0-9]{10}" required>
          <% if (errors?.contact) { %>
          <div class="invalid-feedback">
            <%= errors.contact %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            please enter a valid contact no
          </div>
        </div>
        <div class="col-md-6">
          <label for="inputCity" class="form-label">Email : </label>
          <input type="email" id="inputCity" placeholder="Enter Institute Email" name="email" value="<%= oldData?.email || '' %>" class="form-control <%= errors?.email ? 'is-invalid' : '' %>" required>
          <% if (errors?.email) { %>
          <div class="invalid-feedback">
            <%= errors.email %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            Please Enter a valid Email
          </div>
        </div>
      </div>

      <div class="inline">
        <div class="col-md-4">
          <label for="inputCity" class="form-label">Registration No : </label>
          <input type="text" value="<%= oldData?.regNo || '' %>" class="form-control <%= errors?.regNo ? 'is-invalid' : '' %>" id="inputCity" placeholder="Enter Registration No. " name='registrationNo' maxlength="10" required>
          <% if (errors?.regNo) { %>
          <div class="invalid-feedback">
            <%= errors.regNo %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            please enter Registration No.
          </div>
        </div>

        <div class="col-md-3">
          <label for="name" class="form-label">Admission Date : </label>
          <input type="date" class="form-control" id="exampleFormControlInput1" name="admissionDate" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>

        <div class="col-md-4">
          <label for="inputCity" class="form-label">Roll No : </label>
          <input type="text" value="<%= oldData?.rollNo || '' %>" class="form-control <%= errors?.rollNo ? 'is-invalid' : '' %>" id="inputCity" placeholder="Enter Roll No. " name='rollNo' maxlength="10" required>
          <% if (errors?.rollNo) { %>
          <div class="invalid-feedback">
            <%= errors.rollNo %>
          </div>
          <% } %>
          <div class="invalid-feedback">
            please enter Roll No.
          </div>
        </div>
      </div>

      <div class="mb-3">

        <label for="name" class="form-label">Enter Address : </label>
        <input type="text" class="form-control" id="exampleFormControlInput1" name="Address" placeholder="Eg : 450 , near Airtel tower , Master Colony " required>
        <div class="invalid-feedback">
          this field can't be empty
        </div>

      </div>

      <div class="inline">
        <div class="col-md-3">
          <label for="inputZip" class="form-label">City : </label>
          <input type="text" class="form-control" id="inputZip" name="City" placeholder="Enter City" required>
          <div class="invalid-feedback">
            Please enter your Institute City.
          </div>
        </div>
        <div class="col-md-4">
          <label for="inputState" class="form-label">State</label>
          <select id="inputState" class="form-select" name="State" required>
            <option value="" selected disabled>Select State</option>
            <option value="Andhra Pradesh">Andhra Pradesh</option>
            <option value="Arunachal Pradesh">Arunachal Pradesh</option>
            <option value="Assam">Assam</option>
            <option value="Bihar">Bihar</option>
            <option value="Chhattisgarh">Chhattisgarh</option>
            <option value="Goa">Goa</option>
            <option value="Gujarat">Gujarat</option>
            <option value="Haryana">Haryana</option>
            <option value="Himachal Pradesh">Himachal Pradesh</option>
            <option value="Jharkhand">Jharkhand</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Kerala">Kerala</option>
            <option value="Madhya Pradesh">Madhya Pradesh</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Manipur">Manipur</option>
            <option value="Meghalaya">Meghalaya</option>
            <option value="Mizoram">Mizoram</option>
            <option value="Nagaland">Nagaland</option>
            <option value="Odisha">Odisha</option>
            <option value="Punjab">Punjab</option>
            <option value="Rajasthan">Rajasthan</option>
            <option value="Sikkim">Sikkim</option>
            <option value="Tamil Nadu">Tamil Nadu</option>
            <option value="Telangana">Telangana</option>
            <option value="Tripura">Tripura</option>
            <option value="Uttar Pradesh">Uttar Pradesh</option>
            <option value="Uttarakhand">Uttarakhand</option>
            <option value="West Bengal">West Bengal</option>

            <option value="Andaman and Nicobar Islands">Andaman and Nicobar Islands</option>
            <option value="Chandigarh">Chandigarh</option>
            <option value="Dadra and Nagar Haveli and Daman and Diu">Dadra and Nagar Haveli and Daman and Diu</option>
            <option value="Delhi">Delhi</option>
            <option value="Jammu and Kashmir">Jammu and Kashmir</option>
            <option value="Ladakh">Ladakh</option>
            <option value="Lakshadweep">Lakshadweep</option>
            <option value="Puducherry">Puducherry</option>
            <div class="invalid-feedback">
              Enter Your State
            </div>
          </select>
        </div>
        <div class="col-md-3">
          <label for="inputCity" class="form-label">Pincode : </label>
          <input type="text" class="form-control" id="inputCity" placeholder="6 digit Pin Code" name="pinCode" pattern="[0-9]{6}" required>
          <div class="invalid-feedback">
            Please enter your 4-digit Institute Code.
          </div>
        </div>
      </div>

      <div class="inline">
        <div class="col-md-6">
          <label for="name" class="form-label">Father's Name : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="fatherName" placeholder="Enter Father's Name" required>
          <div class="invalid-feedback">
           Student With this Father Name Already Exist!!
          </div>
        </div>

        <div class="col-md-4">
          <label for="inputCity" class="form-label">Guardian's Contact : </label>
          <input type="text" class="form-control" id="inputCity" placeholder="Enter Institute Contact No. " name="fatherContact" pattern="[0-9]{10}" required>
          <div class="invalid-feedback">
            please enter a valid contact no
          </div>
        </div>

      </div>

      <div class="inline">
        <div class="col-md-6">
          <label for="name" class="form-label">Mother's Name : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="motherName" placeholder="Enter Father's Name" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>

        <div class="col-md-2">
          <label for="inputState" class="form-label">category :</label>
          <select id="inputState" class="form-select" name="category" required>
            <option selected disabled>Select category</option>
            <option value="General">General</option>
            <option value="OBC">OBC</option>
            <option value="SC/ST">SC/ST</option>
            <option value="Other">Other</option>
          </select>
        </div>

      </div>
      <div class="signup-btn">
        <button type="submit" class="btn btn-primary">Add Student</button>
      </div>

    </form>
  </div>
</main>