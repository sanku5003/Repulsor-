<% layout('/flash/flash') %>
<div class="sign-navbar">
  <div class="logo">
    <img src="/photos/Gemini_Generated_Image_bqkgnzbqkgnzbqkg-Picsart-BackgroundRemover.png" alt="" width="180px" height="70px">
  </div>
  <button type="button" class="btn btn-outline-light">Back To Home</button>
</div>


<main class="signup">
  <h1>Add New Student</h1>
  <img src="/photos/Gemini_Generated_Image_4ypngu4ypngu4ypn-removebg-preview.png" alt="" width="500px" style="margin-bottom: 40px; margin: 0 auto;">
  <div class="inner">
    <form action="" method="POST" class="needs-validation" novalidate>
      <div class="inline">
        <div class="col-md-6">
          <label for="name" class="form-label">Enter Student Name : </label>
          <input type="text" class="form-control" id="exampleFormControlInput1" name="name" placeholder="Enter Your Institute Name" required>
          <div class="invalid-feedback">
            this field can't be empty
          </div>
        </div>
        <div class="col-md-2">
          <label for="inputState" class="form-label">Class :</label>
          <select id="inputState" class="form-select" name="class" required>
            <option selected disabled>Select Class</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="10">10</option>
            <option value="11">11</option>
            <option value="12">12</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="inputState" class="form-label">Section :</label>
          <select id="inputState" class="form-select" name="sec" required>
            <option selected disabled>Select Section</option>
            <option value="A">A</option>
            <option value="B">B</option>


          </select>
        </div>
      </div>

      
    </form>
  </div>
</main>